# Copie para .env e preencha. Nunca versione o .env.
# A aplicação e os scripts (create-admin, reset-admin, backup) leem este arquivo.
# Variáveis já definidas no ambiente têm precedência sobre ele.

# --- Aplicação ---
PORT=3000
# development, test ou production
NODE_ENV=development
# URL pública aceita para cookies e CORS. Obrigatória em produção (HTTPS).
APP_ORIGIN=http://localhost:3000

# --- Chave do 2FA (obrigatória) ---
# Defina UMA das duas: TOTP_ENCRYPTION_KEY ou TOTP_ENCRYPTION_KEY_FILE.
# São 32 bytes aleatórios em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde a chave em um cofre de segredos, separada dos backups.
TOTP_ENCRYPTION_KEY=
# Alternativa: caminho de um arquivo contendo a chave (secret do Docker).
# TOTP_ENCRYPTION_KEY_FILE=/run/secrets/totp_encryption_key
# Docker Compose: arquivo no host montado como secret no serviço app.
# TOTP_ENCRYPTION_KEY_SECRET_FILE=./secrets/totp_key.txt

# --- Banco e privacidade ---
# Caminho do SQLite. Padrão: data/inventory.db na raiz do projeto.
# DATABASE_PATH=/caminho/para/inventory.db
# Dias após o desligamento até anonimizar o funcionário (mínimo 30).
EMPLOYEE_ANONYMIZATION_DAYS=1825

# --- Backup ---
# Pasta dos backups locais. Padrão: data/backups na raiz do projeto.
# BACKUP_DIR=/caminho/para/backups
BACKUP_RETENTION_DAYS=30
# Intervalo do serviço de backup do Docker, em segundos (mínimo 60).
# BACKUP_INTERVAL_SECONDS=86400
# Segunda cópia, cifrada com age, fora do volume do banco. Exige AGE_RECIPIENT.
# BACKUP_EXTERNAL_DIR=/mnt/inventory-backups
# Docker Compose: pasta do host (NAS, disco externo) montada como cópia externa.
# BACKUP_EXTERNAL_HOST_DIR=/mnt/nas/inventory-backups
# Chave pública age (começa com age1) usada para cifrar a cópia externa.
# A chave privada correspondente fica fora do servidor.
# AGE_RECIPIENT=age1...
# URL chamada (GET) somente quando o backup termina sem falhas, ex.: healthchecks.
# BACKUP_MONITOR_URL=https://hc-ping.com/seu-uuid

# --- Administrador (usado apenas por create-admin e reset-admin) ---
# ADMIN_NAME=Nome da pessoa
# ADMIN_EMAIL=admin@empresa.com
# Senha provisória em arquivo local. Não deixe senhas neste .env;
# prefira ADMIN_PASSWORD_FILE ou ADMIN_PASSWORD injetada só na execução.
# ADMIN_PASSWORD_FILE=/run/secrets/admin_password
