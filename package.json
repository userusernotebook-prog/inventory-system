{
  "name": "inventario-ativos-interno",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "web:dev": "vite --config frontend/vite.config.ts",
    "web:build": "vite build --config frontend/vite.config.ts",
    "web:typecheck": "tsc --project frontend/tsconfig.json",
    "backup": "node scripts/backup.js",
    "db:rollback": "node scripts/rollback-migration.js",
    "create-admin": "node scripts/create-admin.js",
    "reset-admin": "node scripts/reset-admin.js",
    "privacy:anonymize": "node scripts/anonymize-offboarded.js",
    "test": "node --test --test-concurrency=1",
    "lint": "eslint .",
    "format": "prettier --write \"*.{js,cjs}\" \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"frontend/**/*.{ts,tsx,css,html}\" \"*.{json,md}\" .prettierrc.json",
    "format:check": "prettier --check \"*.{js,cjs}\" \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"frontend/**/*.{ts,tsx,css,html}\" \"*.{json,md}\" .prettierrc.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "argon2": "^0.45.1",
    "better-sqlite3": "^11.8.1",
    "dotenv": "18.0.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.0",
    "otplib": "^13.5.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.4",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
